# Database
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@<pooler_host>:6543/postgres
DIRECT_URL=postgresql://postgres:<password>@<db_host>:5432/postgres
DATABASE_POOL_SIZE=10

# Supabase
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Encrypts payment-provider credentials stored in Postgres.
# Generate a long random value and keep it identical across deployed server instances.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# Firebase Cloud Messaging (FCM)
# Set to the JSON string of your Firebase service account key, or a file path to the JSON.
# Required for push notifications. Never commit the actual key.
FIREBASE_SERVICE_ACCOUNT=

# Client (Vite prefix)
VITE_SUPABASE_URL=https://<project_ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
